{
  "build": {
    "command": "cd frontend && npm install && npm run build",
    "output": "frontend/dist",
    "environment": {
      "NODE_VERSION": "20"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "http://124.220.134.12:3000/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
